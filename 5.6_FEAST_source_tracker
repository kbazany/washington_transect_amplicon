### statistics on FEAST results

ANOVAs
```{r}
# 16S_rhizo
feast_glm <- glm(percent ~ Source + Species + Source:Species, data = feast_16S_rhizo)
# run anova
feast_anova_16S_rhizo <- car::Anova(feast_glm, test.statistic = "F")
feast_anova_16S_rhizo

# 16S_root
feast_glm <- glm(percent ~ Source + Species + Source:Species, data = feast_16S_root)
# run anova
feast_anova_16S_root <- car::Anova(feast_glm, test.statistic = "F")
feast_anova_16S_root

# ITS_rhizo
feast_glm <- glm(percent ~ Source + Species + Source:Species, data = feast_ITS_rhizo)
# run anova
feast_anova_ITS_rhizo <- car::Anova(feast_glm, test.statistic = "F")
feast_anova_ITS_rhizo

# ITS_root
feast_glm <- glm(percent ~ Source + Species + Source:Species, data = feast_ITS_root)
# run anova
feast_anova_ITS_root <- car::Anova(feast_glm, test.statistic = "F")
feast_anova_ITS_root

```
Basically we are seeing significant differences by source but not by species. 

Make the table:
```{r}
# Combine anovas
feast_anova_16S <- feast_anova_16S_rhizo %>%
  rbind(feast_anova_16S_root)
feast_anova_ITS <- feast_anova_ITS_rhizo %>%
  rbind(feast_anova_ITS_root)
feast_anova_con <- feast_anova_16S %>%
  cbind(feast_anova_ITS)

# save formatted table
write.csv(feast_anova_con, file = "results/FEAST_results/feast_anova_raw.csv", 
          row.names = TRUE)

```


