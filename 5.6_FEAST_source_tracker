#### Analyzing FEAST results

```{r}
feast_results <- read_delim("feast_input/feast_compiled_results.csv", delim = ",")
```

# averages

```{r}
feast_averages <- feast_results %>%
  group_by(Species, Sink) %>%
  summarise(percent_from_bulk, percent_from_rhizo, percent_from_unknown)

library(dplyr)

feast_averages <- feast_results %>%
  group_by(Species, Sink, Amplicon) %>%
  summarise(
    avg_percent_from_bulk = mean(percent_from_bulk, na.rm = TRUE),
    avg_percent_from_rhizo = mean(percent_from_rhizo, na.rm = TRUE),
    avg_percent_from_unknown = mean(percent_from_unknown, na.rm = TRUE)
  )

```

# manipulate the results

```{r}
feast_long <- feast_results %>%
  pivot_longer(cols = c(percent_from_bulk, percent_from_rhizo, percent_from_unknown), names_to = "Source", values_to = "percent")


feast_long <- feast_results %>%
  rename(Original_Source = Source) %>% # Rename existing Source column
  pivot_longer(
    cols = c(percent_from_bulk, percent_from_rhizo, percent_from_unknown),
    names_to = "Source",
    values_to = "percent"
  ) %>%
  select(-Original_Source) %>%
  mutate(Source = str_remove(Source, "percent_from_"))

```



### let's make some boxplots

```{r}
