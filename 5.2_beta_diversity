# CCA plot

```{r}
# reformat metadata for CCA to include only environmental variables from the PERMANOVA
meta_1 <- meta %>%
  select_if(is.numeric) %>%
  select(`decade_ave_tmax..deg.c.`, altitude, `pH.2`, `decade_ave_prcp..mm.day.`,
         CN, Mg, Na, Silt, Fe, K, VPDleaf, Tleaf) %>%
  rename(Temperature = `decade_ave_tmax..deg.c.`, 
         Precipitation = `decade_ave_prcp..mm.day.`,
         pH = `pH.2`)
# align ttab and meta then split again to preserve order 
ttab_meta <- merge(meta_1, ttab, by = "row.names")
# set rownames
rownames(ttab_meta) <- ttab_meta$Row.names

# set species (asvtab) and environmental (relevant metadata) for CCA
species_data <- ttab_meta[ ,(ncol(meta_1) + 2):ncol(ttab_meta)]
env_data <- ttab_meta[ , 2:(ncol(meta_1) + 1)]

# run CCA
cca_result <- cca(species_data, env_data)
# summary of the data
summary(cca_result)
# rough plot
plot(cca_result)
#extracting the data as data frame; env data
veg_1 = as.data.frame(cca_result$CCA$biplot)
veg_1["env"] = row.names(veg_1)
#extracting the data; genus from datatable v (in this case "genus" is ASV number)
veg_2 = as.data.frame(cca_result$CCA$v)
veg_2["genus"] = row.names(veg_2)
# extracting sample points (each sample becomes it's own point)
veg_3 <- as.data.frame(cca_result$CCA$u)
veg_3["Row.names"] = ttab_meta$Row.names
# combine with sample data
meta_2 <- meta %>%
  rownames_to_column("Row.names")
veg_4 <- inner_join(meta_2, veg_3)

## Plot in ggplot
# Relevel points by site
veg_5 <- veg_4 %>% 
  select(1:5, c(CCA1, CCA2)) %>%
  mutate(site = fct_relevel(site, "CR1", "CR1.5", "CR2", "CR3", "CR4", "TR4", 
                            "TR3.5", "TR3", "TR2.5", "TR2", "TR1")) %>%
  arrange(site)

# make figure 
cca_plot_16S_full <- ggplot() + 
  geom_point(data = veg_5, aes(x = CCA1, y = CCA2, color = site)) + 
# veg_5 contains the data for the points aligned with the metadata for site info
  scale_color_manual(values=c("#2E86C1","#3C80AD","#4A7A9A","#587487",
                             "#666E73","#746860","#82624D","#905C39",
                             "#9E5626","#AC5013","#BA4A00")) + 
  geom_segment(data = veg_1, # veg_1 contains information for the arrows
    aes(x = 0, y = 0, xend = CCA1, yend = CCA2),
    arrow = arrow(length = unit(0.1, "cm"))) +
  geom_text_repel(data = veg_1,
    aes(x = CCA1, y = CCA2, label = veg_1$env),
    color = "black", size = 3) +
  theme_classic() + # better theme
  geom_hline(yintercept = 0, linetype = "dashed", 
             alpha = 0.5, size = 0.3) + # line at 0
  geom_vline(xintercept = 0, linetype = "dashed", 
             alpha = 0.5, size = 0.3) + # line at 0
#  ggtitle("16S CCA - site") + # title
  xlab("CCA1") + ylab("CCA2") #axis name 
cca_plot_16S_full

# save figure
ggsave(paste0("results/beta_results/CCA_key_variables", term, ".png"), width = 6, height = 4)
```

