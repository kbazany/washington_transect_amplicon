# set rownames
rownames(ttab_meta) <- ttab_meta$Row.names

# set species (asvtab) and environmental (relevant metadata) for CCA
species_data <- ttab_meta[ ,(ncol(meta_1) + 2):ncol(ttab_meta)]
env_data <- ttab_meta[ , 2:(ncol(meta_1) + 1)]

# run CCA
