# CCA plot

```{r}
# reformat metadata for CCA to include only environmental variables from the PERMANOVA
meta_1 <- meta %>%
  select_if(is.numeric) %>%
  select(`decade_ave_tmax..deg.c.`, Fe, altitude, `pH.2`, Fe, 
         `decade_ave_prcp..mm.day.`, CN, Clay, Silt, `C.y`, Na, Tleaf, VPDleaf) %>%
  rename(Temperature = `decade_ave_tmax..deg.c.`, 
         Precipitation = `decade_ave_prcp..mm.day.`,
         pH = `pH.2`, C = `C.y`)
# align ttab and meta then split again to preserve order 
ttab_meta <- merge(meta_1, ttab, by = "row.names")
# set rownames
rownames(ttab_meta) <- ttab_meta$Row.names

# set species (asvtab) and environmental (relevant metadata) for CCA
species_data <- ttab_meta[ ,(ncol(meta_1) + 2):ncol(ttab_meta)]
env_data <- ttab_meta[ , 2:(ncol(meta_1) + 1)]

# run CCA
cca_result <- cca(species_data, env_data)
# summary of the data
summary(cca_result)
# rough plot
plot(cca_result)
#extracting the data as data frame; env data
veg_1 = as.data.frame(cca_result$CCA$biplot)
veg_1["env"] = row.names(veg_1)
#extracting the data; genus from datatable v (in this case "genus" is ASV number)
veg_2 = as.data.frame(cca_result$CCA$v)
veg_2["genus"] = row.names(veg_2)
# extracting sample points (each sample becomes it's own point)
veg_3 <- as.data.frame(cca_result$CCA$u)
veg_3["Row.names"] = ttab_meta$Row.names
# combine with sample data
meta_2 <- meta %>%
  rownames_to_column("Row.names")
veg_4 <- inner_join(meta_2, veg_3)

## Plot in ggplot
