# glms 

```{r}
# run glms
full_glm <- glm(Percent_Turnover ~ Category * niche * climate, data = clim_long)
# run anova
full_anova <- car::Anova(full_glm, test.statistic = "F")
full_anova
# save
full_anova_df <- tidy(full_anova)
# write
write.csv(full_anova_df, file = "results/iCAMP_results/glm_all_categories.csv", row.names = FALSE)

# run glms
selection_glm <- glm(Percent_Turnover ~ Category * niche * climate, data = clim_long_2)
# run anova
