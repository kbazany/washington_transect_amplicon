# Producing the main plot with HSD labels

```{r}
# concat variables
hsd <- clim_long %>%
  mutate(category_niche_climate = paste0(Category, "_", niche, "_", climate))
# run hsd test
hsd_test <- HSD.test(aov(Percent_Turnover ~ category_niche_climate, data = hsd), 
                          "category_niche_climate", group = T)
# extract groups
hsd_groups <- hsd_test$groups

# reorder (ensure matching keys for the join)
hsd_groups_reor <- hsd_groups %>%
  as.data.frame() %>%
  rownames_to_column(var = "category_niche_climate")  # turn rownames into a column
# Ensure "sample_species" values match between both dataframes
hsd <- hsd %>%
  mutate(category_niche_climate = as.character(category_niche_climate))  
hsd_groups_reor <- hsd_groups_reor %>%
  mutate(category_niche_climate = as.character(category_niche_climate)) 
hsd_groups_clim <- hsd_groups_reor # save object

# Merge the dataframes
hsd_with_groups <- hsd %>%
  right_join(hsd_groups_reor, by = "category_niche_climate")  # perform the join
## the percents don't line up .x is exact values, .y is means

# relabel
hsd_df <- hsd_with_groups %>%
  rename(Percent_Turnover = Percent_Turnover.x) %>%
  rename(Average_Percent_Turnover = Percent_Turnover.y)


# Figure
clim_reor <- hsd_df
clim_reor$niche <- factor(clim_reor$niche, levels = c("soil", "rhizo", "roots"))
clim_reor$Category <- factor(clim_reor$Category, levels = c("Homogeneous.Selection", 
                                                            "Heterogeneous.Selection", 
                                                            "Homogenizing.Dispersal", 
                                                            "Dispersal.Limitation", 
                                                            "Drift.and.Others"))
clim_reor$climate <- factor(clim_reor$climate, levels = c("wet", "high", "dry"))

site_box <- ggplot(clim_reor, aes(x = niche, color = Category, y = Percent_Turnover)) + 
  geom_boxplot() + geom_jitter(position = position_dodge(width = .75), size = 1) +
  scale_color_manual(values = c("#593F62", "#7B6D8D", "#8499B1", "#A5C4D4", "#3E5641")) + 
  xlab("Category") + ylab("Percent Turnover") + 
  theme(
    panel.border = element_blank(),
    panel.grid.major = element_blank(),
    panel.grid.minor = element_blank(),
    axis.text = element_text(size = 16),
    text = element_text(size = 16),
    legend.position = "left",
    panel.background = element_rect(fill = "white"),
    axis.line = element_line(colour = "black")) + 
  geom_text(
    data = clim_reor, 
    aes(x = niche, y = (max(Percent_Turnover) + .01), label = groups), 
    position = position_dodge(width = 0.75), 
    size = 4, 
    vjust = 0,
    show.legend = FALSE)
site_box

site_box + facet_wrap(vars(climate))

ggsave("results/iCAMP_results/icamp_box_climate_hsdlabels.png", width = 22, height = 5)


```


