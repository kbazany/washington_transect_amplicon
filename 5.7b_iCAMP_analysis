# reformat by adding informative columns

```{r}
full_1 <- full %>%
  mutate(niche_1 = case_when(
    str_detect(sample1, "rhizo") ~ "rhizo",
    str_detect(sample1, "roots") ~ "roots",
    str_detect(sample1, "soil") ~ "soil"
         )) %>%
  mutate(niche_2 = case_when(
    str_detect(sample2, "rhizo") ~ "rhizo",
    str_detect(sample2, "roots") ~ "roots",
    str_detect(sample2, "soil") ~ "soil"
         )) %>%
  mutate(site_1 = str_extract(sample1, "^[^_]+")) %>%
  mutate(site_2 = str_extract(sample2, "^[^_]+")) %>%
  mutate(niche_niche = paste(niche_1, niche_2, sep = "_")) %>%
  mutate(site_site = paste(site_1, site_2, sep = "_")) %>%
  mutate(climate_1 = case_when(
    str_detect(sample1, "CR1|CR1.5|CR2|CR3") ~ "wet",
    str_detect(sample1, "CR4|TR4|TR3.5|TR3") ~ "high",
    str_detect(sample1, "TR2.5|TR2|TR1") ~ "dry"
  )) %>%
  mutate(climate_2 = case_when(
    str_detect(sample2, "CR1|CR1.5|CR2|CR3") ~ "wet",
    str_detect(sample2, "CR4|TR4|TR3.5|TR3") ~ "high",
    str_detect(sample2, "TR2.5|TR2|TR1") ~ "dry"
  )) %>%
  mutate(climate_climate = paste(climate_1, climate_2, sep = "_"))

full_2 <- full %>%
  mutate(niche_1 = case_when(
    str_detect(sample1, "rhizo") ~ "rhizo",
    str_detect(sample1, "roots") ~ "roots",
    str_detect(sample1, "soil") ~ "soil"
         )) %>%
  mutate(niche_2 = case_when(
    str_detect(sample2, "rhizo") ~ "rhizo",
    str_detect(sample2, "roots") ~ "roots",
    str_detect(sample2, "soil") ~ "soil"
         )) %>%
  mutate(site_1 = str_extract(sample1, "^[^_]+")) %>%
  mutate(site_2 = str_extract(sample2, "^[^_]+")) %>%
  mutate(niche_niche = paste(niche_1, niche_2, sep = "_")) %>%
  mutate(site_site = paste(site_1, site_2, sep = "_")) %>%
  mutate(climate_1 = case_when(
    str_detect(sample1, "CR1|CR1.5|CR2|CR3") ~ "wet",
    str_detect(sample1, "CR4|TR4|TR3.5|TR3") ~ "high",
    str_detect(sample1, "TR2.5|TR2|TR1") ~ "dry"
  )) %>%
  mutate(climate_2 = case_when(
    str_detect(sample2, "CR1|CR1.5|CR2|CR3") ~ "wet",
    str_detect(sample2, "CR4|TR4|TR3.5|TR3") ~ "high",
    str_detect(sample2, "TR2.5|TR2|TR1") ~ "dry"
  )) %>%
  mutate(climate_climate = paste(climate_1, climate_2, sep = "_")) %>%
  mutate(Selection = Heterogeneous.Selection + Homogeneous.Selection) %>%
  mutate(Stochasticity = Heterogeneous.Selection + Dispersal.Limitation + Drift.and.Others)

```


