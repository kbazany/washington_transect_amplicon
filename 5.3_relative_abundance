# Significance test with ANCOM-BC

```{r}
# dry
meta_data <- microbiome::meta(ps)
meta_data$climate <- factor(meta_data$climate, levels = c("dry", "high", "wet"))
phyloseq::sample_data(ps) <- meta_data # change reference group
out <- ancombc(data = ps, 
              assay_name = "counts", 
              tax_level = "Phylum", 
              formula = "climate", 
              group = "climate" )
abun_test <- out$res$diff_abn
abun_dry <- abun_test %>%
  mutate(climatewet = ifelse(climatewet == TRUE, "*", as.character())) %>%
  mutate(climatehigh = ifelse(climatehigh == TRUE, "*", as.character())) %>%
  rename(`dry vs. wet` = climatewet, `dry vs. high` = climatehigh) %>%
  select(-c(2)) %>%
  mutate(across(everything(), ~replace_na(.,"")))
# high
meta_data <- microbiome::meta(ps)
meta_data$climate <- factor(meta_data$climate, levels = c("high", "wet", "dry"))
phyloseq::sample_data(ps) <- meta_data # change reference group
out <- ancombc(data = ps, 
              assay_name = "counts", 
              tax_level = "Phylum", 
              formula = "climate", 
              group = "climate" )
abun_test <- out$res$diff_abn
abun_high <- abun_test %>%
  mutate(climatedry = ifelse(climatedry == TRUE, "*", as.character())) %>%
  mutate(climatewet = ifelse(climatewet == TRUE, "*", as.character())) %>%
  rename(`high vs. dry` = climatedry, `high vs. wet` = climatewet) %>%
  select(-c(2)) %>%
  mutate(across(everything(), ~replace_na(.,"")))
# wet
meta_data <- microbiome::meta(ps)
meta_data$climate <- factor(meta_data$climate, levels = c("wet", "dry", "high"))
phyloseq::sample_data(ps) <- meta_data # change reference group
out <- ancombc(data = ps, 
              assay_name = "counts", 
              tax_level = "Phylum", 
              formula = "climate", 
              group = "climate" )
abun_test <- out$res$diff_abn
abun_wet <- abun_test %>%
  mutate(climatedry = ifelse(climatedry == TRUE, "*", as.character())) %>%
  mutate(climatehigh = ifelse(climatehigh == TRUE, "*", as.character())) %>%
  rename(`wet vs. dry` = climatedry, `wet vs. high` = climatehigh) %>%
  select(-c(2)) %>%
  mutate(across(everything(), ~replace_na(.,"")))
# combine dataframes
ancom_full_16S <- abun_wet %>%
  full_join(abun_high, by = "taxon") %>%
  full_join(abun_dry, by = "taxon") %>%
  select("taxon", "wet vs. high", "wet vs. dry", "high vs. dry")
```



