# Ternary Plot

```{r}
# extract relative abundance from physeq object
tab <- normalized_ps_relabun@otu_table
tab <- as.data.frame(tab)
tax <- normalized_ps_relabun@tax_table
tax <- as.data.frame(tax)
# stitch them together
ttab <- t(tab)
ttab_tax <- ttab %>%
  merge(tax, by = 0)
dim(ttab)
dim(tax)
dim(ttab_tax)
# make ternary plot
tern_16S_full_asv <- ggtern(data = ttab_tax, aes(wet, high, dry)) +
  geom_point(aes(color = Phylum)) 
tern_16S_full_asv
# summarize by phylum
ttab_tax_phylum <- ttab_tax %>%
  select(c(2:4,6)) %>%
  group_by(Phylum) %>%
  summarise(across(where(is.numeric), sum, na.rm = TRUE))
# replot
tern_16S_full_phylum <- ggtern(data = ttab_tax_phylum, aes(wet, high, dry)) +
  geom_point(aes(color = Phylum))
tern_16S_full_phylum

# trying again with total abundance as well
tabt <- as.data.frame(merged_ps@otu_table)
ttabt <- t(tabt)
ttabt <- ttabt %>%
  as.data.frame() %>%
  mutate(total = wet + high + dry) %>%
  select(total)
# combine with tax
ttabt_tax <- ttabt %>%
  rownames_to_column("Row.names") %>%
  inner_join(ttab_tax, by = "Row.names")

# summarize by phylum
ttabt_tax_phylum <- ttabt_tax %>%
  select(c(2:5,7)) %>%
