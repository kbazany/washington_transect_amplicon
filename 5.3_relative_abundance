# Install packages

install.packages("phyloseq")
install.packages("tidyverse")
install.packages("remotes")

# Load packages

```{r}
library(phyloseq)
library(tidyverse)
library(vegan)
library(ANCOMBC)
library(ggtern)
library(ggplot2)
library(magrittr)
```


### Full 16S ###

# Load files

```{r}
tab <- read.table("asv_tables/tab_rare_16S.txt", header = TRUE, sep = "\t")
tax <- read.table("asv_tables/tax_rare_16S.txt", header = TRUE, sep = "\t")
meta <- read.table("asv_tables/meta_rare_16S.txt", header = TRUE, sep = "\t")
# set term
term <- "_16S"
```

# Make Phyloseq Object

```{r}
ps <- phyloseq(
  otu_table(tab, taxa_are_rows = T),
  tax_table(as.data.frame(tax) %>% 
              as.matrix()),
  sample_data(meta))
```

# Abundance barcharts

```{r}
## Site
# To simplify the data
ps = prune_taxa(taxa_sums(ps) > 1000, ps)
# Merge sample by their sampling site
merged_ps = merge_samples(ps, "site") # summed
merged_ps
# normalize samples
total = median(sample_sums(merged_ps))
standf = function(x, t=total) round(t * (x / sum(x)))
normalized_ps = transform_sample_counts(merged_ps, standf)
normalized_ps_relabun = transform_sample_counts(normalized_ps, 
                                                        function(OTU) OTU/sum(OTU) * 100)
# converting to a dataframe for more customized chart
df <- psmelt(normalized_ps_relabun)
# rearrange
df$Sample <- factor(df$Sample, levels = c("CR1", "CR1.5", "CR2", "CR3", "CR4", "TR4",
                                      "TR3.5", "TR3", "TR2.5", "TR2", "TR1"))
# plot
rel_abun_site_bar_16S_full <- ggplot(df, aes(x = Sample, y = Abundance, fill = Phylum)) +
  geom_bar(stat = "identity", position = "stack") +
  theme_classic() +
  labs(x = "Site", y = "Relative Abundance") +
