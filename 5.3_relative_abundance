              assay_name = "counts", 
              tax_level = "Phylum", 
              formula = "climate", 
              group = "climate" )
abun_test <- out$res$diff_abn
abun_wet <- abun_test %>%
  mutate(climatedry = ifelse(climatedry == TRUE, "*", as.character())) %>%
  mutate(climatehigh = ifelse(climatehigh == TRUE, "*", as.character())) %>%
  rename(`wet vs. dry` = climatedry, `wet vs. high` = climatehigh) %>%
  select(-c(2)) %>%
  mutate(across(everything(), ~replace_na(.,"")))
