# Significance test with ANCOM-BC

```{r}
# dry
meta_data <- microbiome::meta(ps)
meta_data$climate <- factor(meta_data$climate, levels = c("dry", "high", "wet"))
phyloseq::sample_data(ps) <- meta_data # change reference group
out <- ancombc(data = ps, 
              assay_name = "counts", 
              tax_level = "Phylum", 
              formula = "climate", 
              group = "climate" )
abun_test <- out$res$diff_abn
abun_dry <- abun_test %>%
  mutate(climatewet = ifelse(climatewet == TRUE, "*", as.character())) %>%
  mutate(climatehigh = ifelse(climatehigh == TRUE, "*", as.character())) %>%
  rename(`dry vs. wet` = climatewet, `dry vs. high` = climatehigh) %>%
  select(-c(2)) %>%
  mutate(across(everything(), ~replace_na(.,"")))
# high
meta_data <- microbiome::meta(ps)
meta_data$climate <- factor(meta_data$climate, levels = c("high", "wet", "dry"))
phyloseq::sample_data(ps) <- meta_data # change reference group
