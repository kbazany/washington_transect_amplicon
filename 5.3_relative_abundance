# Make ternary values based on log corr abun

```{r}
# filter to climate only
meta_climate <- meta %>%
  select("climate")
# stitch to otutab
ttab <- t(tab)
x <- merge(meta_climate, ttab, by = "row.names")
# row sums per climate type
x_mutated <- x %>%
  group_by(climate) %>%
  summarize_if(is.numeric, sum, na.rm = TRUE)
# reformat data
tx <- t(x_mutated)
colnames(tx) <- tx[1,]
tx <- tx[-1,]
class(tx)
tx_1 <- as.data.frame(tx)
tx_1$wet <- as.numeric(tx_1$wet)
tx_1$high <- as.numeric(tx_1$high)
tx_1$dry <- as.numeric(tx_1$dry)

# add taxonomy
tx_tax <- merge(tx_1, tax, by = "row.names")

# filter to minimum 50 reads
tx_tax_filt <- tx_tax %>%
  filter(wet + high + dry > 1000)

# total by phylum
tx_tax_phy <- tx_tax_filt %>%
  group_by(Phylum) %>%
  summarize_if(is.numeric, mean, na.rm = TRUE)

# add relative abundances
tx_tax_phy_rel <- tx_tax_phy %>%
  mutate(total_abundance = wet + high + dry) %>%
  mutate(WET = wet/total_abundance) %>%
  mutate(HIGH = high/total_abundance) %>%
  mutate(DRY = dry/total_abundance)

# reorder
tx_reord <- tx_tax_phy_rel %>%
  arrange(desc(total_abundance))
  
# make ternary plot
ggtern(data = tx_tax, aes(wet, high, dry)) +
  geom_point(aes(color = Phylum))

# make ternary plot of filtered data
ggtern(data = tx_tax_filt, aes(wet, high, dry)) +
  geom_point(aes(color = Phylum))

# make ternary plot of phylums
ggtern(data = tx_tax_phy, aes(wet, high, dry)) +
  geom_point(aes(color = Phylum))

# make ternary plot of phylum rel abun vs. total abun
ggtern(data = tx_tax_phy_rel, aes(WET, HIGH, DRY)) +
  geom_point(aes(color = Phylum, size = total_abundance)) + 
  theme(legend.text = element_text(size = 8))

# something wrong with NA keep an eye on the color coding

# color key for fungi
ggtern(data = tx_reord, aes(WET, HIGH, DRY)) +
  geom_point(aes(color = Phylum, size = total_abundance)) + 
  scale_color_manual(values = c(Basidiomycota = "#393B79", unidentified = "#636363", 
                       Ascomycota = "#637939", `NA` = "#969696", 
                       Mucoromycota = "#8C6D31", Mortierellomycota = "#843C39", 
                       Rozellomycota = "#7B4173", Chytridiomycota = "#5254A3", 
                       Monoblepharomycota = "#8CA252", Glomeromycota = "#BD9E39",
                       Kickxellomycota = "#AD494A")) +
