# Run ANCOM-BC

```{r}
# run ancombc
out_filt = ancombc(data = ps, 
              assay_name = "counts", 
              tax_level = "Phylum", 
              formula = "climate", 
              group = "climate" )
res_filt = out_filt$res
 
View(res_filt)
res_global_filt = out_filt$res_global
 
tab_diff_filt = res_filt$diff_abn
 
write.csv(tab_diff_filt, file = 
            paste0("results/relative_abundance_results/phylum_filt_ancom20", 
                   term, ".csv"))

samp_frac_filt = out_filt$samp_frac
samp_frac_filt[is.na(samp_frac_filt)] = 0 
log_obs_abn_filt = log(out_filt$feature_table + 1)
log_corr_abn_filt = t(t(log_obs_abn_filt) - samp_frac_filt)
 
write.csv(log_corr_abn_filt, file = 
            paste0("results/relative_abundance_results/phylum_filt_ancom_log_corr_abun",
            term, ".csv"))

# transform log_corr_abn_filtered file
log_corr_trans <- t(log_corr_abn_filt) %>%
  merge(meta, by = 0) %>%
  group_by(climate) %>%
  summarize(across(c(2:13), mean))
