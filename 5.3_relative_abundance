# Install packages

install.packages("phyloseq")
install.packages("tidyverse")
install.packages("remotes")

# Load packages

```{r}
library(phyloseq)
library(tidyverse)
library(vegan)
library(ANCOMBC)
library(ggtern)
library(ggplot2)
library(magrittr)
```
### Full 16S

# Load files

```{r}
tab <- read.table("asv_tables/tab_rare_16S.txt", header = TRUE, sep = "\t")
tax <- read.table("asv_tables/tax_rare_16S.txt", header = TRUE, sep = "\t")
meta <- read.table("asv_tables/meta_rare_16S.txt", header = TRUE, sep = "\t")
# set term
term <- "_16S"
```

# Make Phyloseq Object

```{r}
ps <- phyloseq(
  otu_table(tab, taxa_are_rows = T),
  tax_table(as.data.frame(tax) %>% 
              as.matrix()),
  sample_data(meta))
```

