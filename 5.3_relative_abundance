# Ternary Plot

```{r}
# extract relative abundance from physeq object
tab <- normalized_ps_relabun@otu_table
tab <- as.data.frame(tab)
tax <- normalized_ps_relabun@tax_table
tax <- as.data.frame(tax)
# stitch them together
ttab <- t(tab)
ttab_tax <- ttab %>%
  merge(tax, by = 0)
dim(ttab)
dim(tax)
dim(ttab_tax)
# make ternary plot
tern_16S_full_asv <- ggtern(data = ttab_tax, aes(wet, high, dry)) +
  geom_point(aes(color = Phylum)) 
tern_16S_full_asv
# summarize by phylum
ttab_tax_phylum <- ttab_tax %>%
  select(c(2:4,6)) %>%
  group_by(Phylum) %>%
  summarise(across(where(is.numeric), sum, na.rm = TRUE))
# replot
tern_16S_full_phylum <- ggtern(data = ttab_tax_phylum, aes(wet, high, dry)) +
  geom_point(aes(color = Phylum))
tern_16S_full_phylum

# trying again with total abundance as well
tabt <- as.data.frame(merged_ps@otu_table)
ttabt <- t(tabt)
ttabt <- ttabt %>%
  as.data.frame() %>%
  mutate(total = wet + high + dry) %>%
  select(total)
# combine with tax
ttabt_tax <- ttabt %>%
  rownames_to_column("Row.names") %>%
  inner_join(ttab_tax, by = "Row.names")

# summarize by phylum
ttabt_tax_phylum <- ttabt_tax %>%
  select(c(2:5,7)) %>%
  group_by(Phylum) %>%
  summarise(across(where(is.numeric), sum, na.rm = TRUE))
# replot
tern_16S_full_sized_phylum <- ggtern(data = ttabt_tax_phylum, aes(wet, high, dry)) +
  geom_point(aes(color = Phylum, size = total)) + 
  scale_color_manual(values = c(Acidobacteriota = "#393B79", Actinomycetota = "#637939",  
                       Bacillota = "#8C6D31", Bacteroidota = "#843C39", 
                       Chloroflexota = "#7B4173", Gemmatimonadota = "#5254A3", 
                       Myxococcota = "#8CA252", Patescibacteria = "#BD9E39",
                       Planctomycetota = "#AD494A", Pseudomonadota = "#A55194", 
                       Thermoproteota = "#6B6ECF", Verrucomicrobiota = "#B5CF6B", 
                       `NA` = "#969696", Rokubacteria = "#E7BA52", Chlamydiae = "#D6616B", 
                       Latescibacteria = "#CE6DBD", BRC1 = "#9C9EDE", Armatimonadetes = "#CEDB9C", 
                       Cyanobacteria = "#E7CB94", Fibrobacteres = "#E7969C", 
                       Dependentiae = "#DE9ED6", Spirochaetes = "#D5E4A2")) + 
  theme(legend.position = "none")
tern_16S_full_sized_phylum
# save plot
ggsave("results/relative_abundance_results/climate_rel_abun_tern_16S_full.png", 
              width = 5, height = 4.5)
```

# Significance test with ANCOM-BC

```{r}
# dry
meta_data <- microbiome::meta(ps)
meta_data$climate <- factor(meta_data$climate, levels = c("dry", "high", "wet"))
phyloseq::sample_data(ps) <- meta_data # change reference group
out <- ancombc(data = ps, 
              assay_name = "counts", 
              tax_level = "Phylum", 
              formula = "climate", 
              group = "climate" )
abun_test <- out$res$diff_abn
abun_dry <- abun_test %>%
  mutate(climatewet = ifelse(climatewet == TRUE, "*", as.character())) %>%
  mutate(climatehigh = ifelse(climatehigh == TRUE, "*", as.character())) %>%
  rename(`dry vs. wet` = climatewet, `dry vs. high` = climatehigh) %>%
  select(-c(2)) %>%
  mutate(across(everything(), ~replace_na(.,"")))
# high
meta_data <- microbiome::meta(ps)
meta_data$climate <- factor(meta_data$climate, levels = c("high", "wet", "dry"))
phyloseq::sample_data(ps) <- meta_data # change reference group
out <- ancombc(data = ps, 
              assay_name = "counts", 
              tax_level = "Phylum", 
              formula = "climate", 
              group = "climate" )
abun_test <- out$res$diff_abn
abun_high <- abun_test %>%
  mutate(climatedry = ifelse(climatedry == TRUE, "*", as.character())) %>%
  mutate(climatewet = ifelse(climatewet == TRUE, "*", as.character())) %>%
  rename(`high vs. dry` = climatedry, `high vs. wet` = climatewet) %>%
  select(-c(2)) %>%
  mutate(across(everything(), ~replace_na(.,"")))
# wet
meta_data <- microbiome::meta(ps)
meta_data$climate <- factor(meta_data$climate, levels = c("wet", "dry", "high"))
phyloseq::sample_data(ps) <- meta_data # change reference group
out <- ancombc(data = ps, 
              assay_name = "counts", 
              tax_level = "Phylum", 
              formula = "climate", 
              group = "climate" )
abun_test <- out$res$diff_abn
abun_wet <- abun_test %>%
  mutate(climatedry = ifelse(climatedry == TRUE, "*", as.character())) %>%
  mutate(climatehigh = ifelse(climatehigh == TRUE, "*", as.character())) %>%
  rename(`wet vs. dry` = climatedry, `wet vs. high` = climatehigh) %>%
  select(-c(2)) %>%
  mutate(across(everything(), ~replace_na(.,"")))
# combine dataframes
ancom_full_16S <- abun_wet %>%
  full_join(abun_high, by = "taxon") %>%
  full_join(abun_dry, by = "taxon") %>%
  select("taxon", "wet vs. high", "wet vs. dry", "high vs. dry")
```


