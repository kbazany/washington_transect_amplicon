## DADA Denoising

Denoising data by first estimating sequencing error rates and using the dada algorithm. 

```{r}
# De-replicate forward and reverse reads
f_dir_derep <- derepFastq(f_dir_filt_no_missing, verbose = TRUE)
r_dir_derep <- derepFastq(r_dir_filt_no_missing, verbose = TRUE)

# Assigning the sample names to the de-replicated sequence objects
names(f_dir_derep) <- subset(samplenames_dir, 
                                       samplenames_dir%in%sub("_F_filt.fastq", "", 
                                          names(f_dir_derep)))
names(r_dir_derep) <- subset(samplenames_dir, 
                                       samplenames_dir%in%sub("_R_filt.fastq", "", 
                                          names(r_dir_derep)))

# Learning errors for forward and reverse reads. 
f_dir_error <- learnErrors(f_dir_derep, multithread = TRUE)
r_dir_error <- learnErrors(r_dir_derep, multithread = TRUE)

# Error plots for forward & reverse reads
f_dir_error_plot <- plotErrors(f_dir_error, nominalQ = TRUE)
f_dir_error_plot
r_dir_error_plot <- plotErrors(r_dir_error, nominalQ = TRUE)
r_dir_error_plot

# De-noise forward reads with dada2
f_dir_dada <- dada(f_dir_derep, err = f_dir_error, 
                         multithread = TRUE, pool = TRUE) # long! Can perform in QIIME2 if it won't run here, but R gives better diversity estimates because it doesn't filter out singletons

# De-noise reverse reads with dada2
r_dir_dada <- dada(r_dir_derep, err = r_dir_error, 
                         multithread = TRUE, pool = TRUE) # long! Can perform in QIIME2 if it won't run here, but R gives better diversity estimates because it doesn't filter out singletons
```


# Merging the de-noised reads with mergePairs

```{r}
# Merging forward and reverse reads using mergePairs.
dir_merge <- mergePairs(f_dir_dada, f_dir_derep, r_dir_dada,
                              r_dir_derep, verbose = TRUE)

# Creating a sequence table
dir_seqtab <- makeSequenceTable(dir_merge)
# histogram to check average sequence length
hist(nchar(colnames(dir_seqtab)))
```


