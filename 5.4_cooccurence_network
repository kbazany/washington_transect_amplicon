# make network visualizations

### Wet Bulk
## Extracting igraph object from SpeicEasi
# Extract the refitted network (the adjacency matrix)
se.cor  <- cov2cor(as.matrix(getOptCov(se_wet_bulk)))
weighted.adj.mat <- se.cor*getRefit(se_wet_bulk)
# Convert the adjacency matrix to an igraph object
igraph_obj <- adj2igraph(weighted.adj.mat)

## Remove unconnected vertices (Taking this out for now just to see how they look)
# igraph_obj <- igraph::induced_subgraph(igraph_obj, V(igraph_obj)[abs(degree(igraph_obj)) > 0])

## Check node metadata
print(vertex_attr(igraph_obj))

## Modifying Vertices
# Calculate vertex sizes based on degree
vertex_sizes <- ((degree(igraph_obj))/10) + 2  # Adjust the multiplier for visibility
# Set vertex colors
vertex_color <- c(rep("#ADC9D7", ntaxa(ps_16S_wet_bulk_filt)), rep("#F7CA8D", ntaxa(ps_ITS_wet_bulk_filt)))
# Set vertex outline colors
vertex_outline <- c(rep("#385F71", ntaxa(ps_16S_wet_bulk_filt)), rep("#EA9010", ntaxa(ps_ITS_wet_bulk_filt)))

## Modifying Edges
# Extract edge weights
edge_weights <- E(igraph_obj)$weight  # Assumes that edge weights are stored by default
# Create edge color vector based on weights
edge_colors <- ifelse(edge_weights > 0, "#AFBE8F", "#BA8F95")
# Convert to RGBA with adjusted opacity
edge_colors_op <- rgb(t(col2rgb(edge_colors)), alpha = 120, maxColorValue = 255)  # 128 / 255 = 0.5 opacity
# Changing line thickness based on edge weight:
edge_widths <- abs(edge_weights) * 80
# Set the edge weights to their absolute values
E(igraph_obj)$weight <- abs(edge_weights)

## Modifying the layout
fr <- layout_with_fr(igraph_obj) # good! A classic

## Plotting with fr layout
png("results/network_results/wet_bulk_net.png", width = 1000, height = 1000)
plot(igraph_obj, 
     vertex.color = vertex_color, 
     vertex.frame.color = vertex_outline,
     vertex.size = vertex_sizes, 
     vertex.label = NA, 
     edge.color = edge_colors_op,
     edge.width = edge_widths,
     edge.curved = 0.3,
     layout = fr)
dev.off()



