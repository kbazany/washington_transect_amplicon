# Formatted table of basic network stats

```{r}
network_summary_full_tab <- network_summary_full %>%
  separate(col = Network, into = c("Climate", "Niche"), sep = "_") %>%
  mutate(Climate = recode(Climate, 
                          "wet" = "Wet", "high" = "High", "dry" = "Dry")) %>%
  mutate(Niche = recode(Niche,
                          "bulk" = "Bulk Soil", "rhizo" = "Rhizosphere Soil", "root" = "Root Endosphere")) %>%
  rename("Total Nodes" = "Total_Nodes",
         "Bacterial Nodes" = "Bacterial_Nodes",
         "Fungal Nodes" = "Fungal_Nodes", 
         "Total Edges" = "Total_Edges", 
         "Positive Edges" = "Positive_Edges", 
         "Negative Edges" = "Negative_Edges")

# flextable
flext <- flextable(network_summary_full_tab) %>%
  font(part = "all", fontname = "times new roman") %>%
  fontsize(part = "all", size = 8) %>%
  vline(j = c(2,5,8)) %>%
  hline(i = c(3,6), j = c(2:11)) %>%
  merge_v(j = 1) %>%
  align(align = "center", part = "all", j = 3:11) %>%
  width(width = 0) %>%
  autofit() 
flext
# save the table
save_as_docx(flext, path = "results/network_results/network_stat_table.docx")
save_as_image(flext, path = "results/network_results/network_stat_table.png")
