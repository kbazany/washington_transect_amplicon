## node stats
net_stat_wet_bulk <- data.frame(
  total_nodes = (ntaxa(ps_16S_wet_bulk_filt) + ntaxa(ps_ITS_wet_bulk_filt)),
  node_16S = ntaxa(ps_16S_wet_bulk_filt),
  node_ITS = ntaxa(ps_ITS_wet_bulk_filt)
)

## Modifying Edges
# Extract edge weights
edge_weights <- E(igraph_obj)$weight  # Assumes that edge weights are stored by default
# Create edge color vector based on weights
edge_colors <- ifelse(edge_weights > 0, "#AFBE8F", "#BA8F95")
# Convert to RGBA with adjusted opacity
edge_colors_op <- rgb(t(col2rgb(edge_colors)), alpha = 120, maxColorValue = 255)  # 128 / 255 = 0.5 opacity
# Changing line thickness based on edge weight:
edge_widths <- abs(edge_weights) * 80
# save edges stats
net_stat_wet_bulk <- net_stat_wet_bulk %>%
  mutate(pos_edges = sum(edge_weights > 0),
         neg_edges = sum(edge_weights < 0))
# Set the edge weights to their absolute values for visualization
E(igraph_obj)$weight <- abs(edge_weights)

## more network stats
# run clustering algorithm
cl <- cluster_fast_greedy(igraph_obj,
                    merges = TRUE,
                    modularity = TRUE,
                    membership = TRUE,
                    weights = E(igraph_obj)$weight)
# add connectivity and modularity
net_stat_wet_bulk <- net_stat_wet_bulk %>%
  mutate(connectivity = mean(degree(igraph_obj)), # connectivity
         modularity = modularity(cl)) # modularity

## Modifying the layout
fr <- layout_with_fr(igraph_obj) 

## Plotting with fr layout
png("results/network_results/wet_bulk_net.png", width = 1000, height = 1000)
plot(igraph_obj, 
     vertex.color = vertex_color, 
     vertex.frame.color = vertex_outline,
     vertex.size = vertex_sizes, 
     vertex.label = NA, 
     edge.color = edge_colors_op,
     edge.width = edge_widths,
     edge.curved = 0.3,
     layout = fr)
dev.off()
```


