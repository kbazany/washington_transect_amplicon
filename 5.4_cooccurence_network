# Networks and visualizations
This process is very computationally intensive. It's likely crash so save the environment after every speiceasi run and save every network produced as it runs.

```{r}
## Dry Root
# this is the first test because it is expected to be the most sparse network
se_dry_root_ht <- spiec.easi(list(ps_16S_dry_root_filt, ps_ITS_dry_root_filt), 
                                           method = 'glasso', nlambda = 40,
              lambda.min.ratio = 1e-2, pulsar.params = list(thresh = 0.1, rep.num = 100, ncores = 12))
save.image(file = "se_ht_env.RData")
# visualization
## Extracting igraph object from SpeicEasi
# Extract the refitted network (the adjacency matrix)
se.cor  <- cov2cor(as.matrix(getOptCov(se_dry_root_ht)))
weighted.adj.mat <- se.cor*getRefit(se_dry_root_ht)
# Convert the adjacency matrix to an igraph object
igraph_obj <- adj2igraph(weighted.adj.mat)
## Modifying Vertices
# Set vertex colors
vertex_color <- c(rep("#ADC9D7", ntaxa(ps_16S_dry_root_filt)), rep("#F7CA8D", ntaxa(ps_ITS_dry_root_filt)))
# Set vertex outline colors
vertex_outline <- c(rep("#385F71", ntaxa(ps_16S_dry_root_filt)), rep("#EA9010", ntaxa(ps_ITS_dry_root_filt)))
# Remove unconnected vertices (taking this out for now because it's cutting all the fungi)
# igraph_obj <- igraph::induced_subgraph(igraph_obj, V(igraph_obj)[abs(degree(igraph_obj)) > 1])
# Check node metadata
print(vertex_attr(igraph_obj))
# Calculate vertex sizes based on degree
vertex_sizes <- ((degree(igraph_obj))/10) + 2  # Adjust the multiplier for visibility
## Modifying Edges
# Extract edge weights
edge_weights <- E(igraph_obj)$weight  # Assumes that edge weights are stored by default
# Create edge color vector based on weights
edge_colors <- ifelse(edge_weights > 0, "#879B59", "#985D65")
# Convert to RGBA with adjusted opacity
edge_colors_op <- rgb(t(col2rgb(edge_colors)), alpha = 120, maxColorValue = 255)  # 128 / 255 = 0.5 opacity
# Changing line thickness based on edge weight:
edge_widths <- abs(edge_weights) * 80
# Set the edge weights to their absolute values
E(igraph_obj)$weight <- abs(edge_weights)
## Modifying the layout
fr <- layout_with_fr(igraph_obj) 
## Plotting with fr layout
png("results/network_results/se_dry_root_ht_net.png", width = 1000, height = 1000)
plot(igraph_obj, 
     vertex.color = vertex_color, 
     vertex.frame.color = vertex_outline,
     vertex.size = vertex_sizes, 
     vertex.label = NA, 
     edge.color = edge_colors_op,
     edge.width = edge_widths,
     edge.curved = 0.3,
     layout = fr)
dev.off()

