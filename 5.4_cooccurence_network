```

# Load files

We will be making a total of 3 networks, one for the wet sites, one for the high sites, one for the dry sites. SpeicEasi wants standard singly rarefied tables.

```{r}
tab_16S <- read.table("asv_tables/tab_rare_16S.txt", header = TRUE, sep = "\t")
tax_16S <- read.table("asv_tables/tax_rare_16S.txt", header = TRUE, sep = "\t")
meta_16S <- read.table("asv_tables/meta_rare_16S.txt", header = TRUE, sep = "\t")
tab_ITS <- read.table("asv_tables/tab_rare_ITS.txt", header = TRUE, sep = "\t")
tax_ITS <- read.table("asv_tables/tax_rare_ITS.txt", header = TRUE, sep = "\t")
meta_ITS <- read.table("asv_tables/meta_rare_ITS.txt", header = TRUE, sep = "\t")
```

# make tabs with common sample names in the same order

```{r}
# check dimensions
dim(tab_16S)
dim(tab_ITS)
# check common column names
common_cols <- intersect(names(tab_16S), names(tab_ITS))
common_cols # 97 in common
# Reordering to have the same column names and same order
tab_16S <- tab_16S %>% select(all_of(common_cols))
tab_ITS <- tab_ITS %>% select(all_of(common_cols))
# check dimensions
dim(tab_16S)
dim(tab_ITS)
```

# make phyloseq objects

```{r}
ps_16S <- phyloseq(
  otu_table(tab_16S, taxa_are_rows = T),
  tax_table(as.data.frame(tax_16S) %>% 
              as.matrix()),
  sample_data(meta_16S))
ps_ITS <- phyloseq(
  otu_table(tab_ITS, taxa_are_rows = T),
  tax_table(as.data.frame(tax_ITS) %>%
              as.matrix()),
  sample_data(meta_ITS))
```

# cut the data into climate types

```{r}
ps_16S_wet <- subset_samples(ps_16S, climate == "wet")
ps_16S_high <- subset_samples(ps_16S, climate == "high")
ps_16S_dry <- subset_samples(ps_16S, climate == "dry")
ps_ITS_wet <- subset_samples(ps_ITS, climate == "wet")
ps_ITS_high <- subset_samples(ps_ITS, climate == "high")
ps_ITS_dry <- subset_samples(ps_ITS, climate == "dry")
```

# simplify the data

```{r}
ps_16S_wet = prune_taxa(taxa_sums(ps_16S_wet) > 1000, ps_16S_wet)
ps_16S_high = prune_taxa(taxa_sums(ps_16S_high) > 1000, ps_16S_high)
ps_16S_dry = prune_taxa(taxa_sums(ps_16S_dry) > 1000, ps_16S_dry)
ps_ITS_wet = prune_taxa(taxa_sums(ps_ITS_wet) > 1000, ps_ITS_wet)
ps_ITS_high = prune_taxa(taxa_sums(ps_ITS_high) > 1000, ps_ITS_high)
ps_ITS_dry = prune_taxa(taxa_sums(ps_ITS_dry) > 1000, ps_ITS_dry)
```

# make the wet network 16S

```{r}
se_16S_wet <- spiec.easi(ps_16S_wet, method='mb', lambda.min.ratio=1e-2,
                           nlambda=20, pulsar.params=list(rep.num=50))
ig_16S_wet <- adj2igraph(getRefit(se_16S_wet),  vertex.attr=list(name=taxa_names(ps_16S_wet)))
nw_16S_wet <- plot_network(ig_16S_wet, ps_16S_wet, type='taxa', color="Phylum")
nw_16S_wet
```

# make wet network ITS

```{r}
se_ITS_wet <- spiec.easi(ps_ITS_wet, method='mb', lambda.min.ratio=1e-2,
                           nlambda=20, pulsar.params=list(rep.num=50))
ig_ITS_wet <- adj2igraph(getRefit(se_ITS_wet),  vertex.attr=list(name=taxa_names(ps_ITS_wet)))
nw_ITS_wet <- plot_network(ig_ITS_wet, ps_ITS_wet, type='taxa', color="Phylum")
nw_ITS_wet
```

