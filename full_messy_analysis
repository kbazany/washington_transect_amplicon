CCA with only variables from glm
```{r}
# set wd
setwd("~/Desktop/R/incline/qiime_results/analysis_results/")
# mutate to add average temperatures for each time frame
meta_1 <- meta %>%
  mutate(month_ave_t = (`month_ave_tmax (deg c)` + `month_ave_tmin (deg c)`)/2) %>%
  mutate(year_ave_t = (`year_ave_tmax (deg c)` + `year_ave_tmin (deg c)`)/2) %>%
  mutate(decade_ave_t = (`decade_ave_tmax (deg c)` + `decade_ave_tmin (deg c)`)/2)
# make matrix
ttab <- t(tab)
x <- merge(meta_1, ttab, by = "row.names")
# stitch meta to x
meta_1 <- meta_1 %>%
  tibble::rownames_to_column("Row.names")
# reformat metadata for CCA to include only environmental variables
meta_2 <- meta_1 %>%
  as_tibble() %>% # removes row names
  select_if(is.numeric) %>%
  select(-c(1)) # removing tree number
# select only the variables from the glm
meta_3 <- meta_2 %>%
  select(`decade_ave_t`, Fe, `decade_ave_prcp (mm/day)`, `pH 2`, Cu, Na, CN, N.y, VPDleaf) %>%
  rename(`decade_ave_t` = "Temperature", `decade_ave_prcp (mm/day)` = "Precipitation",
         `pH 2` = "pH", N.y = "N")
# check data input
x_cut <- x[ ,(ncol(meta_1) + 2):ncol(x)]
# check dimensions
dim(meta_3)
dim(x_cut)
# data for CCA
species_data <- x_cut
env_data <- meta_3
# run CCA
cca_result <- cca(species_data, env_data)
# summary of the data
summary(cca_result)
# rough plot
plot(cca_result)
#extracting the data as data frame; env data
veg_1 = as.data.frame(cca_result$CCA$biplot)
veg_1["env"] = row.names(veg_1)
#extracting the data; genusv
veg_2 = as.data.frame(cca_result$CCA$v)
veg_2["genus"] = row.names(veg_2)
# extracting sample points
veg_3 <- as.data.frame(cca_result$CCA$u)
veg_3["Row.names"] = meta_1$Row.names
# combine with sample data
veg_4 <- merge(veg_3, meta_1)
