    site == "CR2" ~ "wet",
    site == "CR3" ~ "wet",
    site == "CR4" ~ "high",
    site == "TR4" ~ "high",
    site == "TR3.5" ~ "high",
    site == "TR3" ~ "high",
    site == "TR2.5" ~ "dry",
    site == "TR2" ~ "dry",
    site == "TR1" ~ "dry"
    ))
# filter to climate only
