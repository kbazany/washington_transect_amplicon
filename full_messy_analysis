Certainly! Here’s a step-by-step example of how you can process an amplicon sequence variant (ASV) table in R to create a correlation network. This example will involve calculating Spearman correlations, getting p-values, and preparing the data for Gephi.

### Step 1: Prepare Example Data

First, let's create a mock ASV table. In a real-world scenario, this would be replaced with your actual ASV data.

```{r}
# Load necessary libraries
library(dplyr)
library(tidyr)

# Create a mock ASV table
set.seed(42)
ASV_table <- data.frame(
  SampleID = paste0("Sample", 1:10),
  ASV1 = sample(0:100, 10, replace = TRUE),
  ASV2 = sample(0:100, 10, replace = TRUE),
  ASV3 = sample(0:100, 10, replace = TRUE),
  ASV4 = sample(0:100, 10, replace = TRUE)
)

# View the ASV table
print(ASV_table)
```

### Step 2: Calculate Spearman Correlations

Now we’ll calculate the Spearman correlation coefficients and p-values.

Packages for TSS normalization
```{r}
install.packages("remotes")
remotes::install_github("HuaZou/MyRtools")
```


```{r}
# Remove the SampleID column for correlation analysis
# ASV_data <- ASV_table[, -1]
ASV_data <- wet_tab_t
ASV_data <- as.data.frame(ASV_data)
ASV_data <- na.omit(ASV_data)
# correction
ASV_data_1 <- ASV_data %>%
       mutate(across(where(is.numeric), ~ .x + 1))
# TSS normalization
norm_tss(ASV_data)
# Create an empty dataframe to store results
cor_results <- data.frame()

# Calculate Spearman correlations and p-values
# more robust loop
for (i in 1:(ncol(ASV_data) - 1)) {
  for (j in (i + 1):ncol(ASV_data)) {
    if (sum(is.finite(ASV_data[[i]])) > 1 && sum(is.finite(ASV_data[[j]])) > 1) {
      test <- cor.test(ASV_data[[i]], ASV_data[[j]], method = "spearman")
      
      # Append the results to the data frame
      cor_results <- rbind(cor_results, data.frame(
        Source = colnames(ASV_data)[i],
        Target = colnames(ASV_data)[j],
        SpearmanCor = test$estimate,
        pValue = test$p.value
      ))
    } else {
      message(paste("Skipping comparison of", colnames(ASV_data)[i], "and", colnames(ASV_data)[j], "due to insufficient data."))
    }
  }
}

# View the correlation results
print(cor_results)
```

### Step 3: Adjust P-values and Filter for Significant Correlations

We can adjust the p-values using the Benjamini-Hochberg method and filter for significant correlations.

```{r}
# Adjust p-values for multiple comparisons
cor_results <- cor_results %>%
  mutate(AdjustedPValue = p.adjust(pValue, method = "fdr"))

# Filter for significant correlations (e.g., p < 0.05 and abs(SpearmanCor) > 0.7)
significant_edges <- cor_results %>%
  filter(AdjustedPValue < 0.05 & abs(SpearmanCor) > .7)

# View significant edges
print(significant_edges)
```

### Step 4: Prepare Data for Gephi

Now we will prepare the data in edge list format suitable for Gephi.

```{r}
# Select relevant columns for Gephi
edges <- significant_edges %>%
  select(Source, Target, Weight = SpearmanCor) %>%
  mutate(direction = case_when(Weight > 0 ~ "pos",
         Weight < 0 ~ "neg")) %>%
  mutate(Weight = abs(Weight))

# Write the edges to a CSV file
write.csv(edges, paste0("edges_", sub_term, ".csv"), row.names = FALSE)

# Optionally, you can also create a nodes data frame
nodes <- unique(c(edges$Source, edges$Target)) %>%
  data.frame(id = ., stringsAsFactors = FALSE) 

# Add metadata (microbial kingdom, niche type)

