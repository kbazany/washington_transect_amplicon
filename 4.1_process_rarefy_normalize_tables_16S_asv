# perform TMM normalization

```{r}
# full
dge <- DGEList(counts = otutab_raw) # Create a DGEList object from the count data
dge <- calcNormFactors(dge) # Perform TMM normalization
# Get normalized counts
otutab_tmm_mat <- cpm(dge)  # Use 'cpm' to calculate counts per million
otutab_tmm <- as.data.frame(otutab_tmm_mat)
# soil
dge <- DGEList(counts = otutab_soil_raw) 
dge <- calcNormFactors(dge) 
otutab_tmm_mat <- cpm(dge) 
otutab_soil_tmm <- as.data.frame(otutab_tmm_mat)
# rhizo
dge <- DGEList(counts = otutab_rhizo_raw) 
dge <- calcNormFactors(dge) 
otutab_tmm_mat <- cpm(dge) 
otutab_rhizo_tmm <- as.data.frame(otutab_tmm_mat)
# root
dge <- DGEList(counts = otutab_root_raw) 
dge <- calcNormFactors(dge) 
otutab_tmm_mat <- cpm(dge) 
otutab_root_tmm <- as.data.frame(otutab_tmm_mat)
```

