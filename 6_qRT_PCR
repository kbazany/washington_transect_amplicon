## wet as a standard, by climate

```{r}
# 1) Collapse technical replicates (rows) to one row per sample_id x Primer
#    using your already-computed "Average Cq" and "std dev".
target_by_sample <- qpcr_clean %>%
  group_by(sample_id, site, climate, Primer) %>%
  summarise(
    Cq_target = mean(`Average Cq`, na.rm = TRUE),
    sd_target = mean(`std dev`, na.rm = TRUE),
    .groups = "drop"
  )

# If UBQ10B and 18S are constant within sample_id, pull one value per sample_id.
refs_by_sample <- qpcr_clean %>%
  group_by(sample_id, site, climate) %>%
  summarise(
    Cq_UBQ10B = mean(UBQ10B, na.rm = TRUE),
    Cq_18S    = mean(`18S`,  na.rm = TRUE),
    .groups = "drop"
  )

dat <- target_by_sample %>%
  left_join(refs_by_sample, by = c("sample_id","site","climate")) %>%
  mutate(
    dCq_UBQ10B = Cq_target - Cq_UBQ10B,
    dCq_18S    = Cq_target - Cq_18S,
    Cq_ref_mean = rowMeans(cbind(Cq_UBQ10B, Cq_18S), na.rm = TRUE),
    dCq_ref_mean = Cq_target - Cq_ref_mean
  )

# filter out low reps and any where there is no standard deviation or very high sd 
datfilt <- dat %>%
  filter(Cq_target > 13) %>%
  filter(sd_target != "NaN") %>%
  filter(sd_target < .5)

dim(datfilt)
dim(dat)

dat <- datfilt

# 2) Compute the wet-climate calibrator per Primer (control mean ΔCq)
calibrator <- dat %>%
  filter(climate == "wet") %>%
  group_by(Primer) %>%
  summarise(
    cal_dCq_UBQ10B   = mean(dCq_UBQ10B,   na.rm = TRUE),
    cal_dCq_18S      = mean(dCq_18S,      na.rm = TRUE),
    cal_dCq_ref_mean = mean(dCq_ref_mean, na.rm = TRUE),
    .groups = "drop"
  )

# 3) ΔΔCq and fold-change vs wet
results <- dat %>%
  left_join(calibrator, by = "Primer") %>%
  mutate(
    ddCq_UBQ10B   = dCq_UBQ10B   - cal_dCq_UBQ10B,
    ddCq_18S      = dCq_18S      - cal_dCq_18S,
    ddCq_ref_mean = dCq_ref_mean - cal_dCq_ref_mean,

    FC_UBQ10B   = 2^(-ddCq_UBQ10B),
    FC_18S      = 2^(-ddCq_18S),
    FC_ref_mean = 2^(-ddCq_ref_mean)
  )

results %>% dplyr::select(sample_id, climate, Primer, starts_with("dCq"), starts_with("ddCq"), starts_with("FC"))


results %>%
  filter(climate %in% c("wet","high","dry")) %>%
  group_by(Primer, climate) %>%
  summarise(
    mean_log2FC = mean(log2(FC_ref_mean), na.rm = TRUE),
    sd_log2FC   = sd(log2(FC_ref_mean), na.rm = TRUE),
    n = dplyr::n(),
    .groups = "drop"
  ) %>%
  mutate(
    mean_FC = 2^(mean_log2FC)
  )

```



