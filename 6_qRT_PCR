# significance test (this one is for a regular, welch t-test but I'm using student because that's what I'm seeing in the literature.)

library(dplyr)
library(tidyr)

# Helper: safe t-test p-value (returns NA instead of error)
safe_t_p <- function(x, g, g1 = "high", g0 = "wet") {
  x1 <- x[g == g1]; x1 <- x1[is.finite(x1)]
  x0 <- x[g == g0]; x0 <- x0[is.finite(x0)]
  if (length(x1) < 2 || length(x0) < 2) return(NA_real_)
  tryCatch(t.test(x1, x0)$p.value, error = function(e) NA_real_)
}

# 1) Choose which Cq column to use for technical replicate averaging
# Prefer "Cq outliers removed", else fall back to "Cq original", else "Cq"
qpcr2 <- qpcr_clean %>%
 # mutate(Cq_use = coalesce(`Cq outliers removed`, `Cq original`, Cq)) %>% # running on outliers removed for now
  mutate(Cq_use = `Cq outliers removed`) %>%
  filter(climate %in% c("wet", "high", "dry"))

# 2) Collapse technical replicates to one row per sample_id x Primer
target_by_sample <- qpcr2 %>%
  filter(!is.na(sample_id), !is.na(Primer)) %>%
  group_by(sample_id, site, climate, Primer) %>%
  summarise(
    n_tech = sum(is.finite(Cq_use)),
    Cq_target = mean(Cq_use, na.rm = TRUE),
    sd_target = sd(Cq_use, na.rm = TRUE),
    .groups = "drop"
  )

# 3) Get one UBQ10B and 18S Cq per sample_id
# (Your table has UBQ10B and 18S as columns; we assume they are constant within sample_id.)
refs_by_sample <- qpcr2 %>%
  filter(!is.na(sample_id)) %>%
  group_by(sample_id, site, climate) %>%
  summarise(
    Cq_UBQ10B = mean(UBQ10B, na.rm = TRUE),
    Cq_18S    = mean(`18S`,  na.rm = TRUE),
    .groups = "drop"
  )

# 4) Join targets + refs and compute ΔCq using the mean of UBQ10B and 18S
analysis_dat <- target_by_sample %>%
  left_join(refs_by_sample, by = c("sample_id", "site", "climate")) %>%
  mutate(
    Cq_ref_mean = rowMeans(cbind(Cq_UBQ10B, Cq_18S), na.rm = TRUE),
    dCq_ref_mean = Cq_target - Cq_ref_mean
  )

# 5) Per-Primer significance tests: high vs wet and dry vs wet
ttest_results <- analysis_dat %>%
  group_by(Primer) %>%
  summarise(
    n_wet  = sum(climate == "wet"  & is.finite(dCq_ref_mean)),
    n_high = sum(climate == "high" & is.finite(dCq_ref_mean)),
    n_dry  = sum(climate == "dry"  & is.finite(dCq_ref_mean)),

    mean_wet  = mean(dCq_ref_mean[climate == "wet"],  na.rm = TRUE),
    mean_high = mean(dCq_ref_mean[climate == "high"], na.rm = TRUE),
    mean_dry  = mean(dCq_ref_mean[climate == "dry"],  na.rm = TRUE),

    diff_high_minus_wet = mean_high - mean_wet,
    diff_dry_minus_wet  = mean_dry  - mean_wet,

    p_high = safe_t_p(dCq_ref_mean, climate, "high", "wet"),
    p_dry  = safe_t_p(dCq_ref_mean, climate, "dry",  "wet"),
    .groups = "drop"
  ) %>%
  mutate(
    p_high_adj = p.adjust(p_high, method = "BH"),
    p_dry_adj  = p.adjust(p_dry,  method = "BH")
  )

ttest_results

ttest_results_table <- ttest_results %>%
  mutate(n_total = (n_wet + n_high + n_dry))

write_delim(ttest_results_table, "/Users/8qq/washington_transect/results/qRT_PCR_ttest_table.csv", delim = ",")




