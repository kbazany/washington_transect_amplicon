sp  <- dat %>% select(all_of(asv_cols))
env <- dat %>% select(all_of(env_vars))

cca_fit <- cca(sp ~ ., data = env)

## 2) Build the same plotting objects as your original code: veg_1 (arrows) and veg_5 (points)
