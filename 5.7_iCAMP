# filtering rare taxa

```{r}
comm <- ttab  # rows = samples, cols = ASVs

# much stricter critera filtering for prevalence and total minimum
prev_min <- 10
tot_min  <- 200

keep_asv <- (colSums(comm > 0) >= prev_min) & (colSums(comm) >= tot_min)
comm_f <- comm[, keep_asv, drop = FALSE]

c(n_asv_before = ncol(comm),
  n_asv_after  = ncol(comm_f),
  reads_before = sum(comm),
  reads_after  = sum(comm_f),
  frac_reads_kept = sum(comm_f)/sum(comm))
```


# using blanks and ntcs as a benchmark to filter likely contaminants

```{r}
ctrl <- c("Extraction_blank_rhizo_soil", "NTC_Amp1", "NTC_Amp2")
ctrl <- intersect(ctrl, rownames(comm))  # in case some absent
true <- setdiff(rownames(comm), ctrl)

max_ctrl <- apply(comm[ctrl, , drop=FALSE], 2, max)
max_true <- apply(comm[true, , drop=FALSE], 2, max)

keep_not_contam <- (max_true + 1) > (max_ctrl + 1)  # drop if max_ctrl >= max_true
comm_fc <- comm[, keep_asv & keep_not_contam, drop=FALSE]

# cut ctrls
comm_fc <- comm_fc[setdiff(rownames(comm_fc), ctrl), , drop=FALSE]


# check new table
comm_fc
head(comm_fc)
dim(comm_fc)
dim(comm) 
dim(ttab)
rowSums(comm_fc)
```

