dec_prec_PhiPS2_line <- ggplot(tree_clim, aes(x = `decade_ave_prcp..mm.day.`, y = PhiPS2)) + 
  geom_smooth(method = NULL, se = TRUE, fullrange = TRUE, alpha = .15, color = "black") + geom_point() + 
  xlab("Precipitation (mm)") + ylab("PhiPS2") + 
  theme(
    panel.border = element_blank(),
    panel.grid.major = element_blank(),
    panel.grid.minor = element_blank(),
    axis.text = element_text(size = 16),
    text = element_text(size = 16),
    legend.position = "left",
    panel.background = element_rect(fill = "white"),
    axis.line = element_line(colour = "black"))
dec_prec_PhiPS2_line

# decade max temp
dec_tmax_PhiPS2_line <- ggplot(tree_clim, aes(x = `decade_ave_tmax..deg.c.`, y = PhiPS2)) + 
  geom_smooth(method = NULL, se = TRUE, fullrange = TRUE, alpha = .15, color = "black") + geom_point() + 
  xlab("Average Max Temperature (C)") + ylab("PhiPS2") + 
  theme(
    panel.border = element_blank(),
    panel.grid.major = element_blank(),
    panel.grid.minor = element_blank(),
    axis.text = element_text(size = 16),
    text = element_text(size = 16),
    legend.position = "left",
    panel.background = element_rect(fill = "white"),
    axis.line = element_line(colour = "black"))
dec_tmax_PhiPS2_line

# elevation
elev_PhiPS2_line <- ggplot(tree_clim, aes(x = altitude, y = PhiPS2)) + 
  geom_smooth(method = NULL, se = TRUE, fullrange = TRUE, alpha = .15, color = "black") + geom_point() + 
  xlab("Elevation (m)") + ylab("PhiPS2") + 
  theme(
    panel.border = element_blank(),
    panel.grid.major = element_blank(),
    panel.grid.minor = element_blank(),
    axis.text = element_text(size = 16),
    text = element_text(size = 16),
    legend.position = "left",
    panel.background = element_rect(fill = "white"),
    axis.line = element_line(colour = "black"))
elev_PhiPS2_line
```

