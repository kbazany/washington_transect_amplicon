# Make a combined line plot

```{r}
# all together
full_plot <- ggarrange(dec_prec_gsw_line, dec_tmax_gsw_line, elev_gsw_line,
                       dec_prec_VPDleaf_line, dec_tmax_VPDleaf_line, elev_VPDleaf_line, 
                       dec_prec_PhiPS2_line, dec_tmax_PhiPS2_line, elev_PhiPS2_line,
                       nrow = 3, ncol = 3)
full_plot
# save full plot
ggsave("results/tree_phys/full_clim_line.png", width = 16, height = 13)
```


# Combined with the elevation/precipitation plots

```{r}
# all together
full_plot <- ggarrange(dec_prec_gsw_line, dec_tmax_gsw_line, elev_gsw_line, dec_prec_elev_gsw_line,
                       dec_prec_VPDleaf_line, dec_tmax_VPDleaf_line, elev_VPDleaf_line, dec_prec_elev_VPDleaf_line,
                       dec_prec_PhiPS2_line, dec_tmax_PhiPS2_line, elev_PhiPS2_line, dec_prec_elev_PhiPS2_line,
                       nrow = 3, ncol = 4)
full_plot
# save full plot
ggsave("results/tree_phys/full_clim_with_elev_precip_line.png", width = 20, height = 13)
```


