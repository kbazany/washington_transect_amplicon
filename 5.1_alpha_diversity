# Print tables

Make a clean ANOVA table for climate and niche ANOVA

```{r}
# Combine anovas
combined_anova <- shan_anova_16S %>% 
  rename_with(~ paste(.x, "16S", sep = "_"), -term) %>%
  left_join(shan_anova_ITS %>% rename_with(~ paste(.x, "ITS", sep = "_"), -term), by = "term")
# Rearrange terms based on lowest p-value
combined_anova <- combined_anova %>%
  filter(!grepl("Residuals", term)) %>%
  arrange(p.value_16S) %>%
  bind_rows(combined_anova %>% filter(grepl("Residuals", term)))  # Re-add residuals at the bottom
# Format p-values and rename columns
formatted_table <- combined_anova %>%
  mutate(p.value_16S = formatC(p.value_16S, format = "f", digits = 3)) %>%
  mutate(sig_16S = ifelse(p.value_16S < 0.001, "***",
    ifelse(p.value_16S < 0.01, "**",
    ifelse(p.value_16S < 0.05, "*",
    ifelse(p.value_16S < 0.1, ".", as.character()))))) %>%
  mutate(sig_ITS = ifelse(p.value_ITS < 0.001, "***",
    ifelse(p.value_ITS < 0.01, "**",
    ifelse(p.value_ITS < 0.05, "*",
    ifelse(p.value_ITS < 0.1, ".", as.character()))))) %>%
  mutate(sig_16S = ifelse(term == "Residuals", "", sig_16S)) %>%
  mutate(df_16S = df_16S, df_ITS = df_ITS) %>%
  select(term, df_16S, sumsq_16S, statistic_16S, p.value_16S, sig_16S, 
         sumsq_ITS, statistic_ITS, p.value_ITS, sig_ITS) %>%
  rename(df = df_16S,
    `Sum Sq` = sumsq_16S,
    `F-statistic` = statistic_16S,
    `p-val` = p.value_16S,
    ` ` = sig_16S) %>%
  rename(`Sum Sq ` = sumsq_ITS,
    `F-statistic ` = statistic_ITS,
    `p-val ` = p.value_ITS,
    `  ` = sig_ITS) %>%
  mutate(across(where(is.numeric), ~formatC(., format = "f", digits = 3))) %>%
  mutate(df = str_remove_all(df, '.000')) %>%
  mutate(across(everything(), ~replace_na(.,""))) %>%
  mutate(across(everything(), ~ str_replace_all(., "NA", "")))
formatted_table

# make printable table with flextable
flext <- 0
flext <- flextable(formatted_table) %>%
  add_footer_lines("p-val: < 0.001***, p-val < 0.01**, p-val < 0.05*, p-val < 0.1.") %>%
  font(part = "all", fontname = "times new roman") %>%
  fontsize(part = "all", size = 8) %>%
  add_header_row(colwidths = c(2, 4, 4), values = c("", "16S", "ITS")) %>%
  align(align = "center", part = "all", j = 3:9) %>%
  vline(j = c(2,6), part = "all") %>%
  width(width = 0) %>%
  autofit() # may try padding:   padding(padding = 0, part = "all")
flext
# save the table
save_as_docx(flext, path = "results/alpha_results/anova_table.docx")
save_as_image(flext, path = "results/alpha_results/anova_table.png")
```

