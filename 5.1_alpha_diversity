# Load files (starting with 16S)

```{r}
tab <- read.table("asv_tables/tab_rare_16S.txt", header = TRUE, sep = "\t")
tax <- read.table("asv_tables/tax_rare_16S.txt", header = TRUE, sep = "\t")
meta <- read.table("asv_tables/meta_rare_16S.txt", header = TRUE, sep = "\t")
# set term
term <- "_16S"
```

# Calculate alpha diversity

```{r}
# tables
ttab <- t(tab)
ttab <- as.data.frame(ttab)
head(tab)
head(ttab)
head(meta)
head(tax)

# extract sample ID
meta_1 <- meta %>%
  rownames_to_column(var = "sample_id")
ttab_1 <- ttab %>%
  rownames_to_column(var = "sample_id")
# combine meta and ttab
meta_tab <- meta_1 %>%
  inner_join(ttab_1)

# calc shan
shan <- vegan::diversity((meta_tab[,ncol(meta_1):ncol(meta_tab)]), index = "shannon")
# combine
alpha_df <- cbind(meta_tab, shan)

# calc simpson
simp <- vegan::diversity((meta_tab[,ncol(meta_1):ncol(meta_tab)]), index = "simpson")
# combine
alpha_df <- cbind(alpha_df, simp)
```


# showing in physeq

```{r}
# load into phyloseq
physeq <- phyloseq(
  otu_table(tab, taxa_are_rows = T),
  tax_table(as.matrix(tax)),
  sample_data(meta))
plot_richness(physeq, measures=c("Chao1", "Shannon"), x="climate", color="niche")
```

# ANOVAs for categorical variables

Climate and niche

```{r}
# run glms
shan_glm <- glm(shan ~ climate + niche + climate:niche, data = alpha_df)
# run anova
shan_anova <- car::Anova(shan_glm, test.statistic = "F")
shan_anova

# run glms
simp_glm <- glm(simp ~ climate + niche + climate:niche, data = alpha_df)
# run anova
simp_anova <- car::Anova(simp_glm, test.statistic = "F")
simp_anova

# save anovas
shan_anova_16S <- tidy(shan_anova)
simp_anova_16S <- tidy(simp_anova)
```

