# Correlation Tests

```{r}
# test normality 
## shan
hist(alpha_df$shan)
shapiro.test(alpha_df$shan)
qqnorm(alpha_df$shan)
## precip
hist(alpha_df$decade_ave_prcp..mm.day.)
shapiro.test(alpha_df$decade_ave_prcp..mm.day.)
qqnorm(alpha_df$decade_ave_prcp..mm.day.)
## temp
hist(alpha_df$decade_ave_tmax..deg.c.)
shapiro.test(alpha_df$decade_ave_tmax..deg.c.)
qqnorm(alpha_df$decade_ave_tmax..deg.c.)
## elevation
hist(alpha_df$altitude)
shapiro.test(alpha_df$altitude)
qqnorm(alpha_df$altitude)
### non-normal distribution (because roots much lower than soil, so ~bimodal)
#Split by niche
alpha_df_soil <- alpha_df %>%
  filter(niche == "soil")
alpha_df_rhizo <- alpha_df %>%
  filter(niche == "rhizo")
alpha_df_root <- alpha_df %>%
  filter(niche == "roots")
# retest by niche (pearson probably ok for the niche separated ones)
## soil # not normal but better, some gaps
hist(alpha_df_soil$shan)
shapiro.test(alpha_df_soil$shan) 
qqnorm(alpha_df_soil$shan)
## rhizo # not normal, right skewed
hist(alpha_df_rhizo$shan)
shapiro.test(alpha_df_rhizo$shan) 
qqnorm(alpha_df_rhizo$shan)
## root # normal!
hist(alpha_df_root$shan)
shapiro.test(alpha_df_root$shan) 
qqnorm(alpha_df_root$shan)
```

