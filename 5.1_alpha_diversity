# Create a function to extract metadata from the dataframe name
extract_metadata <- function(df_name) {
  method <- ifelse(grepl("16S", df_name), "16S", "ITS")
  sample <- ifelse(grepl("soil", df_name), "Soil",
              ifelse(grepl("rhizo", df_name), "Rhizosphere", 
                ifelse(grepl("root", df_name), "Roots", "All")))
  variable <- ifelse(grepl("precip", df_name), "Precipitation",
               ifelse(grepl("tmax", df_name), "Average Max Temperature", "Elevation"))
  return(c(method, sample, variable))
}

# Combine results into a single dataframe (whoopsie I want the estimate not the variable, estimate is the actual pearson correlation coefficient, the statistic is the chi-squared)
combined_results <- bind_rows(
  lapply(names(data_frames), function(df_name) {
    df <- data_frames[[df_name]]  # Retrieve the actual data frame using its name
    # Extract metadata
    metadata <- extract_metadata(df_name)
    # Check if df has required columns - replace 'statistic' and 'p.value' as necessary
    df %>%
      mutate(Method = metadata[1],
             Sample = metadata[2],
             Variable = metadata[3]) %>%
      select(Method, Sample, Variable, estimate, p.value) # Adjust column names accordingly
  })
)

# Modify combined dataframe
full_cor <- combined_results %>%
  rename(Amplicon = Method) %>%
  rename(Niche = Sample) %>%
  rename(Pearson = estimate) %>%
  rename(`p-val` = p.value) %>%
  mutate(`p-val` = formatC(`p-val`, format = "f", digits = 3)) %>%
  mutate(Pearson = formatC(Pearson, format = "f", digits = 3)) %>%
  mutate(sig = ifelse(`p-val` < 0.001, "***",
    ifelse(`p-val` < 0.01, "**",
    ifelse(`p-val` < 0.05, "*",
    ifelse(`p-val` < 0.1, ".", ""))))) %>%
  select(c(Variable, Amplicon, Niche, Pearson, `p-val`, sig))
# Make wide format
full_cor_wide <- full_cor %>%
  pivot_wider(names_from = Niche, values_from = c(Pearson, `p-val`, sig)) %>%
  select(Variable, Amplicon,
    Pearson_All, `p-val_All`, sig_All,  # First columns for 'All'
    Pearson_Soil, `p-val_Soil`, sig_Soil,  # then for 'Soil'
    Pearson_Rhizosphere, `p-val_Rhizosphere`, sig_Rhizosphere,  # for 'Rhizosphere'
    Pearson_Roots, `p-val_Roots`, sig_Roots) %>%
  rename(
    All_Pearson = Pearson_All,
    `All_p-val` = `p-val_All`,
    `All_ ` = sig_All,
    Soil_Pearson = Pearson_Soil,
    `Soil_p-val` = `p-val_Soil`,
    `Soil_ ` = sig_Soil,
    Rhizosphere_Pearson = Pearson_Rhizosphere,
    `Rhizosphere_p-val` = `p-val_Rhizosphere`,
    `Rhizosphere_ ` = sig_Rhizosphere,
    Roots_Pearson = Pearson_Roots,
    `Roots_p-val` = `p-val_Roots`,
    `Roots_ ` = sig_Roots
  )

# Building the table
