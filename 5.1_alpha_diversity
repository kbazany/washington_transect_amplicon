# Niche and Climate boxplot

```{r}
# reorder
alpha_df_reor <- alpha_df
alpha_df_reor$niche <- factor(alpha_df_reor$niche, levels = c("soil", "rhizo", "roots"))
# reorder site
alpha_df_reor$climate <- factor(alpha_df_reor$climate, levels = c("wet", "high", "dry"))
# shan boxplot
shan_box_16S <- ggplot(alpha_df_reor, aes(x = climate, color = niche, y = shan)) + 
  geom_boxplot() + geom_jitter(position = position_dodge(width = .75), size = 1) +
  scale_color_manual(values = c("#a64551", "#a68a45", "#6ea645")) + 
  xlab("Climate Class") + ylab("16S Shannon Diversity") + 
  theme(
    panel.border = element_blank(),
    panel.grid.major = element_blank(),
    panel.grid.minor = element_blank(),
    axis.text = element_text(size = 16),
    text = element_text(size = 16),
    legend.position = "left",
    panel.background = element_rect(fill = "white"),
    axis.line = element_line(colour = "black"))
shan_box_16S

# simpson boxplot
simp_box_16S <- ggplot(alpha_df_reor, aes(x = climate, color = niche, y = simpson)) + 
  geom_boxplot() + geom_jitter(position = position_dodge(width = .75), size = 1) +
  scale_color_manual(values = c("#a64551", "#a68a45", "#6ea645")) + 
  xlab("Climate Class") + ylab("16S Simpson Diversity") + 
  theme(
    panel.border = element_blank(),
    panel.grid.major = element_blank(),
    panel.grid.minor = element_blank(),
    axis.text = element_text(size = 16),
    text = element_text(size = 16),
    legend.position = "left",
    panel.background = element_rect(fill = "white"),
    axis.line = element_line(colour = "black"))
simp_box_16S
```

