lme_full_table_clean <- lme_full_table %>%
  mutate(sig = ifelse(`Pr(>|t|)` < 0.001, "***",
    ifelse(`Pr(>|t|)` < 0.01, "**",
    ifelse(`Pr(>|t|)` < 0.05, "*",
    ifelse(`Pr(>|t|)` < 0.1, ".", ""))))) %>%
  mutate(variable = str_replace(variable, fixed("alpha_df$decade_ave_prcp..mm.day."), "Precipitation")) %>%
  mutate(variable = str_replace(variable, fixed("alpha_df$altitude"), "Altitude")) %>%
  mutate(variable = str_replace(variable, fixed("alpha_df$decade_ave_tmax..deg.c."), "Temperature")) 

lme_full_table_clean
write_delim(lme_full_table_clean, "lme_shannon_diversity_vs_climate.csv", delim = ",")
