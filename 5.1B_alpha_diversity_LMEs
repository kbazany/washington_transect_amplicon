```

# Load files (starting with 16S)

```{r}
tab <- read.table("asv_tables/tab_rare_16S.txt", header = TRUE, sep = "\t")
tax <- read.table("asv_tables/tax_rare_16S.txt", header = TRUE, sep = "\t")
meta <- read.table("asv_tables/meta_rare_16S.txt", header = TRUE, sep = "\t")
# set term
term <- "_16S"
```

# Calculate alpha diversity

```{r}
# tables
ttab <- t(tab)
ttab <- as.data.frame(ttab)
head(tab)
head(ttab)
head(meta)
head(tax)

# extract sample ID
meta_1 <- meta %>%
  rownames_to_column(var = "sample_id")
ttab_1 <- ttab %>%
  rownames_to_column(var = "sample_id")
# combine meta and ttab
meta_tab <- meta_1 %>%
  inner_join(ttab_1)

# calc shan
shan <- vegan::diversity((meta_tab[,ncol(meta_1):ncol(meta_tab)]), index = "shannon")
# combine
alpha_df <- cbind(meta_tab, shan)

# calc simpson
simp <- vegan::diversity((meta_tab[,ncol(meta_1):ncol(meta_tab)]), index = "simpson")
# combine
alpha_df <- cbind(alpha_df, simp)
```


# mixed effect model for alpha-diversity v. climate correlations with site as random factor 

```{r}
# prcp
lme <- lmer(shan ~ alpha_df$`decade_ave_prcp..mm.day.` + (1 | site), data = alpha_df)
summary(lme)
results_df <- as.data.frame(coef(summary(lme)))
results_df$variable <- rownames(results_df)
results_df$amplicon <- "16S"
results_df$niche <- "All"
print(results_df)
lme_prcp <- results_df

# temp
lme <- lmer(shan ~ alpha_df$`decade_ave_tmax..deg.c.` + (1 | site), data = alpha_df)
summary(lme)
results_df <- as.data.frame(coef(summary(lme)))
results_df$variable <- rownames(results_df)
results_df$amplicon <- "16S"
results_df$niche <- "All"
print(results_df)
lme_temp <- results_df

# alti
lme <- lmer(shan ~ alpha_df$altitude + (1 | site), data = alpha_df)
summary(lme)
results_df <- as.data.frame(coef(summary(lme)))
results_df$variable <- rownames(results_df)
results_df$amplicon <- "16S"
results_df$niche <- "All"
print(results_df)
lme_alti <- results_df

# combine
lme_16S <- rbind(lme_prcp, lme_temp, lme_alti)
```

