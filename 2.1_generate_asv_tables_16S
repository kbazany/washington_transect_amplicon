# Read sequencing run tables

```{r}
# check file names and paths
########
# read in soil_rhizo data
soil_rhizo_seqtab <- read.table("soil_rhizo_seqtab_16S_asv.txt", header = TRUE, 
                                sep = '\t', na.strings = ".") #long

# read in root data
root_seqtab <- read.table("root_seqtab_16S_asv.txt", header = TRUE, 
                          sep = '\t', na.strings = ".") #long

# save as matrix
soil_rhizo_seqtab_m <- as.matrix(soil_rhizo_seqtab)
root_seqtab_m <- as.matrix(root_seqtab)
```

# Combine tables

```{r}
merged_seqtab <- mergeSequenceTables(soil_rhizo_seqtab_m, root_seqtab_m)

# check dimensions of original and combined table (should have added rows and combined some columns)
dim(soil_rhizo_seqtab_m)
dim(root_seqtab_m)
dim(merged_seqtab)

# writing to the data folder
####### 
# change file name
write.table(merged_seqtab, "merged_seqtab_16S_asv.txt", sep = "\t")
```

# Remove chimeras

```{r}
# Remove chimeras from the merged ASV table:
seqtab_nochim <- removeBimeraDenovo(merged_seqtab, 
                                         method = "consensus",  
                                         multithread = TRUE, 
                                         verbose = TRUE)

# Number of ASVs in the table:
ncol(seqtab_nochim)
# Number of samples in the table:
nrow(seqtab_nochim)

# Number of sequences
sum(merged_seqtab)
# Number of sequences
sum(seqtab_nochim)

# write nochim seqtab
######
# change file name
write.table(seqtab_nochim, "nochim_merged_seqtab_16S_asv.txt", sep = "\t")
```

# Assign taxonomy with assignTaxonomy

I used the .fa training file on the DADA2 github.
https://benjjneb.github.io/dada2/training.html

```{r}
# Assigning taxonomy using the assignTaxonomy function. 
#### Update SILVA each time to make sure we are getting the latest assignments 
# Assign sequences with SILVA:
taxa <- assignTaxonomy(seqtab_nochim, 
                          "silva_nr99_v138.2_toSpecies_trainset.fa.gz", 
                          multithread = TRUE, minBoot = 80) # long

# Converting the taxonomy assignments to data frame so we can filter the taxonomic assignments.
taxa_original <- as.data.frame(taxa)

# Filtering out ASVs not assigned to a phyla
taxa_no_na <- taxa_original[-(which(is.na(taxa_original$Phylum))),]

# Filtering out ASVs not assigned to bacteria or archaea
taxa_bac <- taxa_no_na[grep("Bacteria|Archaea", taxa_no_na$Kingdom),]

# Filtering out ASVs assigned to a chloroplast
taxa_nochl <- taxa_bac[grep("Chloroplast", taxa_bac$Order, invert = TRUE),]

# Filtering out ASVs assigned to a mitochondria
taxa_nohost <- taxa_nochl[grep("Mitochondria", taxa_nochl$Family, invert = TRUE),]

```

## Taxonomy Merging and ASV Filtering
The last step is to filter the ASV abundance table by merging the ASV table with the taxonomy assignments. This will remove ASVs from the count table that were not assigned to a fungal phyla or were identified as nematodes or plant sequences. 

```{r}
# Transposing the ASV table so that taxonomy can be added. 
t_seqtab_nochim <- t(seqtab_nochim)

# Merging the two tables together based on row name. 
t_seqtab_filt <- 
  t_seqtab_nochim[row.names(t_seqtab_nochim)%in%row.names(
    taxa_nohost),]

#####
# Change the sub for different amplicons
colnames(t_seqtab_filt) <- sub("16S_S[0-9].*", "16S", colnames(t_seqtab_nochim))

# Number of ASVs & number of sequences post-filtering
nrow(t_seqtab_filt)
sum(t_seqtab_filt)

# Merging taxonomy information into ASV table
t_seqtab_tax <- merge(t_seqtab_filt, taxa_nohost, by = "row.names")

#  Creating ASV labels and make these new row names.
#####
# Change the sub for different amplicons
asv <- as.character(c(1:nrow(t_seqtab_tax)))
asv <- paste0("ASV_16S_", labels(asv)) #### change label

# Write with the sequences
#####
# Change the sub for different amplicons
write.table(t_seqtab_tax, "o16S_asvtab_sequences.csv", 
            row.names = TRUE, col.names = TRUE, sep = ',')

write.table(t_seqtab_tax, "o16S_asvtab_sequences.txt", 
            row.names = TRUE, col.names = TRUE, sep = '\t')

row.names(t_seqtab_tax) <- NULL
row.names(t_seqtab_tax) <- asv

write.table(t_seqtab_tax, "o16S_asvtab.csv", 
            row.names = TRUE, col.names = TRUE, sep = ',')

write.table(t_seqtab_tax, "o16S_asvtab.txt", 
            row.names = TRUE, col.names = TRUE, sep = '\t')
```

