  mutate(Niche = recode(Niche,
                          "bulk" = "Bulk Soil", "rhizo" = "Rhizosphere Soil", "root" = "Root Endosphere")) %>%
  rename("Total Nodes" = "Total_Nodes",
         "Bacterial Nodes" = "Bacterial_Nodes",
