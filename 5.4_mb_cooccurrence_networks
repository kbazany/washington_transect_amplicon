# combine the 16S and ITS data for each sample type 

```{r}
# check sample names
sample_names(ps_16S_wet_bulk)
sample_names(ps_ITS_wet_bulk)
# sample names don't match
# take only the samples that are in both
shared_samples <- intersect(sample_names(ps_16S_wet_bulk), sample_names(ps_ITS_wet_bulk))
shared_samples
phyloseq_16S <- prune_samples(shared_samples, ps_16S_wet_bulk)
phyloseq_ITS <- prune_samples(shared_samples, ps_ITS_wet_bulk)
# merge otu tables
otu_16S <- otu_table(phyloseq_16S)
otu_ITS <- otu_table(phyloseq_ITS)
# Combine the two OTU tables
combined_otu <- merge(otu_16S, otu_ITS, by = 'row.names', all = TRUE)
rownames(combined_otu) <- combined_otu[, 1]
combined_otu <- combined_otu[, -1]
combined_otu <- as.matrix(combined_otu)
# combine vertically
combined_otu <- rbind(otu_16S, otu_ITS)
# merge taxonomy
tax_16S <- tax_table(phyloseq_16S)
tax_ITS <- tax_table(phyloseq_ITS)
# Combine the taxonomy tables
combined_tax <- rbind(tax_16S, tax_ITS)
# ensure metadata is correct
metadata_16S <- sample_data(phyloseq_16S)
metadata_ITS <- sample_data(phyloseq_ITS)
# Ensure metadata is consistent
identical(metadata_16S, metadata_ITS) # If TRUE, you can proceed
# check consistancy
metadata_16S <- sample_data(phyloseq_16S)
identical(rownames(metadata_16S), shared_samples) # If FALSE, align them manually
rownames(metadata_16S) <- shared_samples
#rownames(combined_otu) <- shared_samples
dim(combined_otu)
# make combined physeq
combined_phyloseq <- phyloseq(
  otu_table(combined_otu, taxa_are_rows = TRUE),
  tax_table(combined_tax),
  sample_data(metadata_16S)
)
# check physeq object
combined_phyloseq@otu_table
combined_phyloseq@tax_table
combined_phyloseq@sam_data
head(combined_phyloseq@otu_table)
head(combined_phyloseq@tax_table)
tail(combined_phyloseq@otu_table)
tail(combined_phyloseq@tax_table)
# make new object
ps_wet_bulk <- combined_phyloseq

