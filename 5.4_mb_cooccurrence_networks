# extract the adjacency matrix from Spieceasi object
weighted.adj.mat <- getRefit(se_high_rhizo_mb)
# Convert the adjacency matrix to an igraph object
igraph_obj <- adj2igraph(weighted.adj.mat)
# add to igraph object
V(igraph_obj)$phylum <- taxonomy$Phylum
# check ids
V(igraph_obj)$phylum
# Extract edge weights
edge_weights <- E(igraph_obj)$weight
# Extract Node Information
num_bacterial_nodes <- taxa %>%
  filter(Kingdom == "Bacteria") %>%
  nrow()
num_fungal_nodes <- taxa %>%
  filter(Kingdom == "k__Fungi") %>%
  nrow()
num_archaeal_nodes <- taxa %>%
  filter(Kingdom == "Archaea") %>%
  nrow()
total_nodes <- as.data.frame(ps_high_rhizo_filt@tax_table) %>%
  nrow()
# Extract Edge Information (mb method doesn't use edge weight so negative will be 0)
positive_edges <- sum(edge_weights > 0)
negative_edges <- sum(edge_weights < 0)
total_edges <- ecount(igraph_obj) # make sure pos_ed + neg_ed = total_ed!
# Degree
degree_values <- degree(igraph_obj)
degree_values
# Transitivity
transitivity_val <- transitivity(igraph_obj, type = "global") # Global transitivity
# Density
density_val <- edge_density(igraph_obj)
## transform edges to positive
E(igraph_obj)$weight <- abs(edge_weights) # not necessary for mb method
# calculations requiring positive edges
closeness_values <- closeness(igraph_obj, normalized = TRUE) # need positive edges only
# Modularity
community_struct <- cluster_fast_greedy(igraph_obj) # need positive edges only
modularity_val <- modularity(community_struct) # need positive edges only
# betweenness
betweenness_values <- betweenness(igraph_obj, normalized = TRUE) # need positive edges only
# Combine Results into a Data Frame
node_metrics <- data.frame(
  Node_ID = V(igraph_obj)$name,
#  Phylum = V(igraph_obj)$phylum,
  Degree = degree_values,
  Closeness = closeness_values, # not found (need positive edges only)
  Betweenness = betweenness_values)
