### Rarefy the data. Every subset should be rarefied to the same depth

```{r}
# check the sample sums of each raw table
sample_sums(ps_wet_bulk)
# rarefy
ps_wet_bulk_rare <- rarefy_even_depth(
      ps_wet_bulk,
      sample.size = 10000,
      rngseed = 56, # Use the same seed as set above
      replace = FALSE, # Typically, subsampling is done without replacement
      trimOTUs = TRUE, # Remove OTUs that become zero after rarefaction
      verbose = TRUE # Set to FALSE to suppress messages
    )
# check sample size after
sample_sums(ps_wet_bulk_rare)
# check to see if samples were dropped
dim(ps_wet_bulk@otu_table)
dim(ps_wet_bulk_rare@otu_table)

# check the sample sums of each raw table
sample_sums(ps_wet_rhizo)
# rarefy
ps_wet_rhizo_rare <- rarefy_even_depth(
      ps_wet_rhizo,
      sample.size = 10000,
      rngseed = 56, # Use the same seed as set above
      replace = FALSE, # Typically, subsampling is done without replacement
      trimOTUs = TRUE, # Remove OTUs that become zero after rarefaction
