  ggplot(mapping = aes(Closeness, Degree, color = Phylum)) + 
  geom_point(size = 1.2) + 
  labs(x = "Closeness Centrality", y = "Degree") +
  theme(panel.grid = element_blank(), 
        panel.background = element_rect(color = 'black', fill = 'transparent'), 
        legend.key = element_rect(color = 'transparent', fill = 'transparent'), 
        legend.position = "right", legend.text = element_text(size = 10), 
        legend.key.size = unit(0.3, "lines")) +
  scale_color_manual("Phylum", values=phylum_colors_2) +
  xlim(0.1, .39) + ylim(1.1, 12.6)
