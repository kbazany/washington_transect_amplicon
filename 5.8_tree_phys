# combine figures
setwd("results/")
dir.create("tree_phys")
```{r}
# set path
setwd("results/tree_phys/")
# arrange
full_plot <- ggarrange(gsw_box, gsw_box_clim, 
                       vpdleaf_box, vpdleaf_box_clim,
                       ps2_box, ps2_box_clim,
                       nrow = 3, ncol = 2, 
                       widths = c(3, 1), 
                       common.legend = TRUE, legend = "right")
full_plot
# save full plot
ggsave("tree_phys.png", width = 10, height = 6)
```


